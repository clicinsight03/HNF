<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      POST_NOTIFICATIONS is required on Android 13+ for the app to show
      any notification, including ones delivered via Firebase Cloud
      Messaging - request it at runtime (Android 13+ requires an explicit
      user prompt, it isn't granted just by declaring it) before relying
      on push notifications actually appearing. See
      Services/PushTokenService.Android.cs for where the FCM token is
      obtained once you've added the Firebase Messaging package.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
