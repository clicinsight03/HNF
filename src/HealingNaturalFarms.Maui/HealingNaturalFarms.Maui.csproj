<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <!--
      Windows is deliberately left out of TargetFrameworks here. The
      standard `dotnet new maui` template would add
      net10.0-windows10.0.19041.0, but that TFM only builds/runs on a
      Windows host with the Windows workload installed, and this app's
      brief was Android + iOS. Add it back
      (`;net10.0-windows10.0.19041.0`) if you also want a Windows
      Machine/WinUI target - nothing else in this project depends on
      Android/iOS specifically except the Platforms/Android and
      Platforms/iOS folders, which only compile for their own TFM.
    -->
    <OutputType>Exe</OutputType>
    <RootNamespace>HealingNaturalFarms.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name and bundle/package id - change these before publishing to a store. -->
    <ApplicationTitle>Healing Natural Farms</ApplicationTitle>
    <ApplicationId>com.healingnaturalfarms.app</ApplicationId>
    <ApplicationIdGuid>2F1B7B7E-6C9A-4B7A-9B0E-2B7B6E6C9A4B</ApplicationIdGuid>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1f3d2b" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1f3d2b" BaseSize="128,128" />

    <!-- Images (tab icons, product placeholders, etc. - drop files into Resources/Images) -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts (none bundled yet - see the note in MauiProgram.cs) -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    No PackageReference entries at all: <UseMaui>true</UseMaui> above
    already brings in Microsoft.Maui.Controls/Essentials as implicit
    framework references (the same way Microsoft.NET.Sdk.Web implicitly
    references the ASP.NET Core shared framework) - an explicit
    PackageReference for it would be redundant at best. This project
    calls HttpClient directly rather than through IHttpClientFactory, so
    it doesn't need Microsoft.Extensions.Http either. That leaves this
    project dependency-free apart from Domain, same as Payments and
    Web.Client - deliberate, since this sandbox has no NuGet access to
    verify a package against. The one deferred integration
    (Firebase/APNs push - see Services/PushTokenService.cs) is
    documented there with the exact package and native setup steps to
    add on your own machine.
  -->

  <ItemGroup>
    <ProjectReference Include="..\HealingNaturalFarms.Domain\HealingNaturalFarms.Domain.csproj" />
  </ItemGroup>

</Project>
