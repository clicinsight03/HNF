<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Same palette as the Blazor storefront's app.css (:root custom
  properties) so the mobile app and the web app read as one brand.
  Plain Color resources throughout (not Brush) - every property these
  are used against on standard MAUI controls (BackgroundColor, TextColor,
  BorderColor, Frame.BorderColor) is Color-typed, not Brush-typed.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BrandGreen900">#1f3d2b</Color>
    <Color x:Key="BrandGreen700">#2f5d3a</Color>
    <Color x:Key="BrandGreen600">#3c7a4a</Color>
    <Color x:Key="BrandGreen500">#4f9460</Color>
    <Color x:Key="BrandEarth600">#8a5a34</Color>
    <Color x:Key="CreamBackground">#faf7f0</Color>
    <Color x:Key="CreamCard">#f1ead9</Color>
    <Color x:Key="InkText">#22281f</Color>
    <Color x:Key="MutedText">#6b6f63</Color>
    <Color x:Key="DangerText">#b3261e</Color>
    <Color x:Key="DangerBackground">#f4dede</Color>
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="BorderColor">#d9d3c3</Color>

</ResourceDictionary>
