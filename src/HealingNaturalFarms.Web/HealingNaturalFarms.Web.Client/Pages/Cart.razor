@page "/cart"
@inject CartState Cart
@inject RegionState Region
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Your Cart &mdash; Healing Natural Farms</PageTitle>

<div class="hnf-container hnf-section">
    <h1>Your Cart</h1>

    @if (_loading)
    {
        <p class="hnf-muted">Loading&hellip;</p>
    }
    else if (Cart.Cart is null || Cart.Cart.Items.Count == 0)
    {
        <div class="hnf-empty-state">
            <p>Your cart is empty.</p>
            <a class="hnf-btn hnf-btn-primary" href="/shop/Plant">Continue shopping</a>
        </div>
    }
    else
    {
        <div class="hnf-cart-layout">
            <div class="hnf-cart-items">
                @foreach (var item in Cart.Cart.Items)
                {
                    <div class="hnf-cart-row">
                        <div class="hnf-cart-thumb">
                            @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" alt="@item.Name" />
                            }
                            else
                            {
                                <span class="hnf-thumb-placeholder">🌿</span>
                            }
                        </div>
                        <div class="hnf-cart-info">
                            <h4>@item.Name</h4>
                            <span class="hnf-price">@FormatMoney(item.UnitPrice)</span>
                        </div>
                        <div class="hnf-qty-stepper">
                            <button @onclick="() => UpdateQtyAsync(item.ProductId, item.Quantity - 1)" disabled="@_busy">&minus;</button>
                            <span>@item.Quantity</span>
                            <button @onclick="() => UpdateQtyAsync(item.ProductId, item.Quantity + 1)" disabled="@_busy">+</button>
                        </div>
                        <div class="hnf-cart-line-total">@FormatMoney(item.LineTotal)</div>
                        <button class="hnf-link-btn hnf-remove-btn" @onclick="() => UpdateQtyAsync(item.ProductId, 0)" disabled="@_busy">Remove</button>
                    </div>
                }
            </div>

            <div class="hnf-cart-summary">
                <h3>Order Summary</h3>
                <div class="hnf-summary-row">
                    <span>Subtotal</span>
                    <span>@FormatMoney(Cart.Cart.Subtotal)</span>
                </div>
                <p class="hnf-muted hnf-small">Shipping and tax are calculated at checkout.</p>
                <a class="hnf-btn hnf-btn-primary hnf-btn-block hnf-btn-lg" href="/checkout">Proceed to Checkout</a>
                <a class="hnf-btn hnf-btn-secondary hnf-btn-block" href="@($"/shop/{ProductType.Plant}")">Continue shopping</a>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += OnCartChanged;
        Region.Changed += OnRegionChanged;
        await Cart.RefreshAsync();
        _loading = false;
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);
    private async void OnRegionChanged() => await InvokeAsync(async () => await Cart.RefreshAsync());

    private async Task UpdateQtyAsync(int productId, int newQty)
    {
        _busy = true;
        StateHasChanged();
        try
        {
            await Cart.UpdateQuantityAsync(productId, newQty);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private string FormatMoney(decimal amount) =>
        Cart.Cart?.Currency == CurrencyCode.USD
            ? amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
            : amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-IN"));

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        Region.Changed -= OnRegionChanged;
    }
}
